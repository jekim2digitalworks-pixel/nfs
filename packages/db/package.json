{
  "name": "@nfs/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma 스키마 + 생성된 클라이언트. 이 패키지 밖에서 스키마를 정의하지 않는다",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "migrate:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1"
  },
  "devDependencies": {
    "prisma": "^7.9.1",
    "typescript": "^5",
    "dotenv": "^17.2.4"
  }
}
