// NFS 데이터 모델
//
// 단일 원천은 docs/개발/02-데이터모델.md 다. 이 파일은 그 문서의 구현체다.
// 컬럼을 추가·변경하려면 문서를 먼저 고친다.
//
// ⚠️ Prisma 7 주의 (N-024)
//   - generator 는 prisma-client (구 prisma-client-js 아님). output 이 필수다
//   - datasource 에 url 을 쓰지 않는다. CLI 용 URL 은 prisma.config.ts 가 갖는다
//   - 런타임 커넥션은 앱이 드라이버 어댑터로 직접 넘긴다 (아키텍처 §7)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// enum
//
// Postgres 네이티브 enum 을 쓴다. varchar 였다면 오타가 런타임까지 갔을 값들이다.
// 값 문자열은 packages/domain/types 와 **글자 하나까지 같아야 한다.**
// ─────────────────────────────────────────────────────────────

/// 카테고리 태그 — 고정 7종 + 미분류 (기획/03-서비스정책 §5)
enum CategoryTag {
  DEVELOPMENT
  MEETING
  STUDY
  FAMILY
  HEALTH
  PERSONAL
  CHORE
  UNCATEGORIZED

  @@map("category_tag")
}

/// 진행 중인 블록의 상태. 완료 상태가 없는 이유는 완료 즉시 원장으로 넘어가고 행이 사라지기 때문이다
enum BlockStatus {
  READY
  RUNNING
  PAUSED

  @@map("block_status")
}

/// 원장 한 줄의 출처. 집중 시간(실측)과 일정 시간(신고)을 끝까지 나누는 축이다
enum SourceType {
  NFS_BLOCK
  GOOGLE_CALENDAR

  @@map("source_type")
}

/// 블록이 어떻게 끝났는가. AUTO_SETTLED 는 신뢰도 낮은 데이터로 구분한다
enum CompletionType {
  NORMAL_COMPLETED
  EARLY_FINISHED
  AUTO_SETTLED
  ABANDONED
  CALENDAR_IMPORTED

  @@map("completion_type")
}

enum GoogleScopeLevel {
  NONE
  READ_ONLY
  READ_WRITE

  @@map("google_scope_level")
}

enum ClosingStatus {
  OPEN
  CLOSED

  @@map("closing_status")
}

enum CalendarSyncResult {
  SYNCED
  FAILED
  NOT_CONNECTED

  @@map("calendar_sync_result")
}

// ─────────────────────────────────────────────────────────────
// 회원
// ─────────────────────────────────────────────────────────────

model Member {
  memberId    BigInt @id @default(autoincrement()) @map("member_id")
  email       String @unique @db.VarChar(255)
  displayName String @map("display_name") @db.VarChar(100)

  googleUserId String? @unique @map("google_user_id") @db.VarChar(64)

  /// ⚠️ 암호화해서 저장한다. 연동 해제 시 즉시 파기 (기획/03 §7)
  /// 이 값이 서버에 있어야 배치가 캘린더를 동기화할 수 있다 (N-021)
  googleRefreshToken String?          @map("google_refresh_token") @db.VarChar(512)
  googleScopeLevel   GoogleScopeLevel @default(NONE) @map("google_scope_level")

  /// 가입 시 1회 과거 백필(4~8주) 완료 여부. 재실행 방지용
  calendarBackfilled Boolean @default(false) @map("calendar_backfilled")

  createdTime DateTime @default(now()) @map("created_time") @db.Timestamptz(0)

  activeBlocks           ActiveBlock[]
  importedCalendarEvents ImportedCalendarEvent[]
  timeLogs               TimeLog[]
  weeklyClosings         WeeklyClosing[]
  categoryColorMappings  CategoryColorMapping[]

  @@map("member")
}

// ─────────────────────────────────────────────────────────────
// 가변 작업 영역 — 진행 중인 것만 산다
// ─────────────────────────────────────────────────────────────

/// 진행 중인 블록. 사용자당 0~6행만 유지되고, 정산 즉시 삭제된다.
///
/// 인덱스를 member_id 하나로 제한하는 이유:
///   타이머가 도는 동안 초 단위로 UPDATE 되는 테이블이다.
///   통계용 복합 인덱스를 여기 걸면 그 비용을 매 UPDATE 가 문다. (N-007)
model ActiveBlock {
  activeBlockId BigInt @id @default(autoincrement()) @map("active_block_id")
  memberId      BigInt @map("member_id")

  /// 비우면 화면이 태그명을 대신 보여준다
  title       String      @db.VarChar(100)
  categoryTag CategoryTag @map("category_tag")
  blockStatus BlockStatus @default(READY) @map("block_status")

  /// 30분 격자에 정렬된 시각
  plannedStartTime DateTime @map("planned_start_time") @db.Timestamptz(0)

  /// 30의 배수, 30~180. planned_end_time 을 따로 두지 않는다 —
  /// 컬럼으로 두면 시작+길이와 어긋날 수 있다
  plannedMinutes Int @map("planned_minutes")

  /// 타이머를 처음 누른 시각. 예약만 하고 시작 안 했으면 null
  actualStartTime DateTime? @map("actual_start_time") @db.Timestamptz(0)

  /// 마지막 일시정지 시점까지의 누적. RUNNING 중인 구간은 여기 없다
  accumulatedFocusSeconds Int @default(0) @map("accumulated_focus_seconds")

  /// RUNNING 으로 전이한 시각. 경과 = accumulated + (now - lastResumed)
  lastResumedTime DateTime? @map("last_resumed_time") @db.Timestamptz(0)

  pauseCount Int @default(0) @map("pause_count")

  /// 자정 배치의 기준일. 23:59 에 만든 블록은 당일, 00:01 은 익일이다
  workDate DateTime @map("work_date") @db.Date

  createdTime DateTime @default(now()) @map("created_time") @db.Timestamptz(0)

  member Member @relation(fields: [memberId], references: [memberId], onDelete: Cascade)

  @@index([memberId], map: "idx_active_block_member")
  @@map("active_block")
}

/// 열린 주의 구글 캘린더 사본. 동기화 캐시를 겸한다.
/// 주간 마감 시 time_log 로 이관하고 삭제한다.
model ImportedCalendarEvent {
  importedEventId BigInt @id @default(autoincrement()) @map("imported_event_id")
  memberId        BigInt @map("member_id")

  googleCalendarId String  @map("google_calendar_id") @db.VarChar(255)
  googleEventId    String  @map("google_event_id") @db.VarChar(255)
  /// 같으면 갱신을 생략한다. 동기화 비용을 줄이는 값
  googleEtag       String? @map("google_etag") @db.VarChar(128)

  title String @db.VarChar(200)

  /// ⭐ 원본을 보존한다. 색상→태그 매핑 규칙이 바뀌어도 재계산할 수 있다
  googleColorId     String?     @map("google_color_id") @db.VarChar(10)
  mappedCategoryTag CategoryTag @map("mapped_category_tag")

  startTime DateTime @map("start_time") @db.Timestamptz(0)
  endTime   DateTime @map("end_time") @db.Timestamptz(0)

  /// 소속 주(월요일 날짜). 마감 판단과 범위 조회의 축이다
  weekStartDate DateTime @map("week_start_date") @db.Date

  /// 필터 7종의 결과 + 사용자 토글
  excludedFromStatistics Boolean @default(false) @map("excluded_from_statistics")

  /// ALL_DAY / DECLINED / TOO_LONG / NFS_ORIGIN / USER
  ///
  /// 여기만 enum 이 아니라 varchar 인 이유: 필터는 운영하면서 늘어난다.
  /// enum 이면 사유 하나 추가할 때마다 마이그레이션이 필요하다.
  exclusionReason String? @map("exclusion_reason") @db.VarChar(30)

  lastSyncedTime DateTime @map("last_synced_time") @db.Timestamptz(0)

  member Member @relation(fields: [memberId], references: [memberId], onDelete: Cascade)

  @@unique([memberId, googleEventId], map: "uk_imported_member_event")
  @@index([memberId, weekStartDate], map: "idx_imported_member_week")
  @@map("imported_calendar_event")
}

// ─────────────────────────────────────────────────────────────
// 불변 원장 ⭐
// ─────────────────────────────────────────────────────────────

/// 시간 가계부의 원장. **한 번 INSERT 되면 UPDATE 하지 않는다.**
///
/// active_block 과 FK 를 맺지 않는 이유: 원본 행이 이관 직후 삭제된다.
/// 읽기 전용이므로 인덱스를 과감히 건다.
model TimeLog {
  timeLogId BigInt @id @default(autoincrement()) @map("time_log_id")
  memberId  BigInt @map("member_id")

  sourceType SourceType @map("source_type")

  /// ⭐ 멱등성 키. NFS_BLOCK 이면 active_block_id 의 문자열, GOOGLE_CALENDAR 면 구글 이벤트 id.
  /// 타입이 다른 두 키를 문자열 하나로 합친 대가로 UNIQUE 제약을 한 줄로 끝낸다
  sourceReferenceKey String @map("source_reference_key") @db.VarChar(255)

  title String @db.VarChar(200)

  /// ⭐ 이관 시점의 스냅샷. 나중에 태그 정책이 바뀌어도 과거 통계가 소급 변경되지 않는다
  categoryTag CategoryTag @map("category_tag")

  /// 통계 집계 기준일 = 시작한 날
  statDate DateTime @map("stat_date") @db.Date

  startTime DateTime @map("start_time") @db.Timestamptz(0)
  endTime   DateTime @map("end_time") @db.Timestamptz(0)

  plannedMinutes Int @map("planned_minutes")

  /// ⭐ 통계 SUM 의 대상
  actualFocusMinutes Int @map("actual_focus_minutes")

  /// 다른 일정과 겹쳐서 차감된 분. 합집합 계산의 결과를 남겨둔다 (기획/03 §2)
  overlapDeductedMinutes Int @default(0) @map("overlap_deducted_minutes")

  completionType CompletionType @map("completion_type")
  pauseCount     Int            @default(0) @map("pause_count")

  createdTime DateTime @default(now()) @map("created_time") @db.Timestamptz(0)

  member Member @relation(fields: [memberId], references: [memberId], onDelete: Cascade)

  /// ⭐⭐ 배치 재실행·네트워크 재시도로 같은 원본이 두 번 정산되는 것을 DB 가 막는다.
  /// 애플리케이션 검사에만 의존하면 동시 실행 시 뚫린다
  @@unique([memberId, sourceType, sourceReferenceKey], map: "uk_time_log_source")
  @@index([memberId, statDate], map: "idx_time_log_member_date")
  @@index([memberId, categoryTag, statDate], map: "idx_time_log_member_tag_date")
  @@map("time_log")
}

// ─────────────────────────────────────────────────────────────
// 마감 · 설정
// ─────────────────────────────────────────────────────────────

/// "구글을 다시 부를지 말지"의 유일한 판단 근거.
///
/// ISO 연도+주차 대신 월요일 날짜를 키로 쓴다.
/// 2025년 1주차가 2024-12-30 에 시작하는 식의 연말 경계 함정이 없고,
/// 날짜 문자열은 사전순 정렬이 곧 시간순이다.
model WeeklyClosing {
  weeklyClosingId BigInt   @id @default(autoincrement()) @map("weekly_closing_id")
  memberId        BigInt   @map("member_id")
  weekStartDate   DateTime @map("week_start_date") @db.Date

  closingStatus ClosingStatus @default(OPEN) @map("closing_status")
  closedTime    DateTime?     @map("closed_time") @db.Timestamptz(0)

  /// 마감 시 최종 동기화의 결과. FAILED 여도 마감은 진행한다 —
  /// 한 명의 구글 장애가 전체 배치를 멈추면 안 된다
  calendarSyncResult CalendarSyncResult @default(NOT_CONNECTED) @map("calendar_sync_result")
  lastSyncedTime     DateTime?          @map("last_synced_time") @db.Timestamptz(0)

  importedEventCount Int @default(0) @map("imported_event_count")

  member Member @relation(fields: [memberId], references: [memberId], onDelete: Cascade)

  @@unique([memberId, weekStartDate], map: "uk_weekly_closing_member_week")
  @@map("weekly_closing")
}

/// 구글 캘린더 색상(colorId) → NFS 카테고리 태그 매핑.
/// 사용자가 설정 화면에서 직접 고른다
model CategoryColorMapping {
  mappingId BigInt @id @default(autoincrement()) @map("mapping_id")
  memberId  BigInt @map("member_id")

  googleColorId String      @map("google_color_id") @db.VarChar(10)
  categoryTag   CategoryTag @map("category_tag")

  member Member @relation(fields: [memberId], references: [memberId], onDelete: Cascade)

  @@unique([memberId, googleColorId], map: "uk_color_mapping_member_color")
  @@map("category_color_mapping")
}
