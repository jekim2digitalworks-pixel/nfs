{
  "name": "nfs",
  "version": "0.1.0",
  "private": true,
  "description": "NFS (Not For Sale) — 시간 가계부 + 마이크로 타임박싱",
  "scripts": {
    "dev": "pnpm --filter @nfs/web dev",
    "build": "pnpm --filter @nfs/db generate && pnpm --filter @nfs/web build",
    "start": "pnpm --filter @nfs/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:tz": "node scripts/test-timezones.mjs",
    "db:generate": "pnpm --filter @nfs/db generate",
    "db:migrate": "pnpm --filter @nfs/db migrate",
    "postinstall": "pnpm --filter @nfs/db generate"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.23.0",
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "typescript": "^5"
  }
}
