# ─────────────────────────────────────────────────────────────
# NFS 환경변수 견본
#
# 실제 값은 .env.local 에 넣는다. .gitignore 가 .env* 를 막고 있다.
# ⚠️ 커넥션 문자열에는 DB 비밀번호가 들어 있다. 채팅·이슈·PR 에 붙여넣지 않는다.
# ─────────────────────────────────────────────────────────────

# ── Supabase (N-022) ──────────────────────────────────────────
# 런타임용 — 풀러(pgBouncer). 서버리스는 호출마다 커넥션을 잡으므로 반드시 풀러를 쓴다.
# connection_limit=1 은 함수 인스턴스 하나가 커넥션 하나만 쥐게 한다.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 마이그레이션용 — 직결(5432). 풀러로 마이그레이션하면 준비된 구문을 지원하지 않아 실패한다.
# Prisma 7 에서는 prisma.config.ts 가 이 값을 읽는다 (datasource.directUrl 은 없어졌다).
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# migrate dev 의 드리프트 감지용 섀도 DB. 선택 사항이지만 없으면
# Prisma 가 대상 DB 옆에 임시 DB 를 만들려다 권한에서 막힐 수 있다.
# SHADOW_DATABASE_URL="postgresql://..."

# ── 구글 OAuth (N-014) ────────────────────────────────────────
# 리다이렉트 URI: http://localhost:3000/api/auth/google/callback  (+ 운영 도메인)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── 배치 (N-022) ──────────────────────────────────────────────
# GitHub Actions 크론이 x-cron-secret 헤더로 보낸다.
# ⚠️ Vercel 환경변수와 GitHub Secrets 양쪽에 **같은 값**으로 넣는다.
CRON_SECRET=""

# ── 세션 ──────────────────────────────────────────────────────
# 세션 쿠키 서명 키. 아무 난수 32바이트 이상.
SESSION_SECRET=""

# ⚠️ NEXT_PUBLIC_ 접두사가 붙은 값만 브라우저로 나간다. 여기에 시크릿을 넣지 않는다.
